{
  "info": {
    "_postman_id": "6c1f4a52-9c1e-4a0e-9e0f-7f4a1b2c3d4e",
    "name": "API-HUB 示例接口",
    "description": "用来试 API-HUB 的示例集合：先把 scripts/preview.mjs 跑起来（echo 靶子在 127.0.0.1:8798），再把这个文件导入。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8798" },
    { "key": "token", "value": "demo-token-123" },
    { "key": "userId", "value": "1024" }
  ],
  "item": [
    {
      "name": "01 基础调用",
      "item": [
        {
          "name": "回显 GET（带查询参数）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/echo?name=张三&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["echo"],
              "query": [
                { "key": "name", "value": "张三" },
                { "key": "page", "value": "1" }
              ]
            },
            "description": "最简单的连通性测试：把方法、头、体原样回显。"
          }
        },
        {
          "name": "取 JSON（看格式化）",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/json", "host": ["{{baseUrl}}"], "path": ["json"] }
          }
        },
        {
          "name": "取纯文本",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "zh-CN", "disabled": true }],
            "url": "{{baseUrl}}/text"
          }
        }
      ]
    },
    {
      "name": "02 带请求体",
      "item": [
        {
          "name": "POST JSON 体",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"张三\",\n  \"age\": 30,\n  \"tags\": [\"vip\", \"beta\"],\n  \"profile\": { \"city\": \"杭州\", \"active\": true }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/echo"
          }
        },
        {
          "name": "POST 表单（x-www-form-urlencoded）",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "demo" },
                { "key": "password", "value": "p@ss word" },
                { "key": "remember", "value": "true", "disabled": true }
              ]
            },
            "url": "{{baseUrl}}/echo"
          }
        },
        {
          "name": "PUT 重置密码",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"password\": \"{{$randomInt}}-new\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/echo/users/{{userId}}/password"
          }
        },
        {
          "name": "DELETE 删除用户",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/echo/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["echo", "users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "03 状态码与异常",
      "item": [
        {
          "name": "404",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/status/404" }
        },
        {
          "name": "500",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/status/500" }
        },
        {
          "name": "302 跳转",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/redirect" }
        },
        {
          "name": "gzip 压缩响应",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/gzip" }
        },
        {
          "name": "超大响应（约 200KB）",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/big" }
        },
        {
          "name": "故意写错的地址",
          "request": { "method": "GET", "header": [], "url": "http://127.0.0.1:1/nope" }
        }
      ]
    },
    {
      "name": "04 认证",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "继承分组 Bearer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/echo?auth=inherit"
          }
        },
        {
          "name": "Basic Auth",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "123456" }
              ]
            },
            "url": "{{baseUrl}}/echo?auth=basic"
          }
        },
        {
          "name": "API Key 放请求头",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "X-Api-Key" },
                { "key": "value", "value": "key-abc-123" },
                { "key": "in", "value": "header" }
              ]
            },
            "url": "{{baseUrl}}/echo?auth=apikey"
          }
        },
        {
          "name": "API Key 放查询参数",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "api_key" },
                { "key": "value", "value": "key-in-query" },
                { "key": "in", "value": "query" }
              ]
            },
            "url": "{{baseUrl}}/echo?auth=apikey-query"
          }
        }
      ]
    },
    {
      "name": "05 慢请求",
      "item": [
        {
          "name": "等 1.5 秒",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/slow",
            "description": "用来看「发送中」和取消按钮。"
          }
        }
      ]
    }
  ]
}
